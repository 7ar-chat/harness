---
import Layout from '../layouts/Layout.astro';
import img_chart from '../assets/chart.webp';
import img_ui_approval from '../assets/ui-approval.webp';
import img_ui_session from '../assets/ui-session.webp';
import img_ui_memory from '../assets/ui-memory.webp';
---
<Layout title="7ar.chat: the agent that ships the deliverable, not just the diff" description="Open agent harness for teams. Agents run in a sandbox, build charts, decks, spreadsheets and PDFs, look at their own output, fix it, and remember what your team decided." path="/">

<section class="hero">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Open agent harness · self-hosted · multi&#8209;user</p>
    <h1 data-reveal style="--d:1">The agent that ships the deliverable, <em>not just the diff.</em></h1>
    <div class="hero-meta" style="margin-top:28px" data-reveal>
      <p class="lede" style="margin:0">Ask in chat. 7ar's agents work in a real sandbox, build the chart, deck, spreadsheet or PDF, <strong>render it, look at it, fix it</strong>, and remember what your team decided.</p>
      <div class="cta">
        <a class="btn primary" href="https://app.7ar.chat">Open the app</a>
        <a class="btn" href="/get-started/">Get started</a>
      </div>
    </div>
  </div>

  <div class="wrap stage-glow">
    <div class="win replay" aria-label="A 7ar session, condensed from the chart run in the showcase">
      <div class="win-bar"><i></i><i></i><i></i><span>7ar · session · revenue chart</span></div>
      <div class="win-body">
        <aside class="side">
          <p>Sessions</p>
          <div>Q3 board deck</div>
          <div class="on">Revenue chart</div>
          <div>Budget workbook</div>
          <div>Decision memo</div>
          <p style="margin-top:20px">Project</p>
          <div>Memory</div>
        </aside>
        <div class="main">
          <div class="log">
            <div class="line you" data-gap="900"><b>you</b><span>Line chart of monthly revenue, annotated milestones. Then look at it and fix any layout problems.</span></div>
            <div class="line"><b>build</b><span>renders revenue.png in the sandbox</span></div>
            <div class="line"><b>look</b><span>view_file: this model cannot see images</span></div>
            <div class="line"><b>measure</b><span>switches to measuring text geometry</span></div>
            <div class="line bad"><b>found</b><span>label past the right edge · axis title clipped · milestones on the line</span></div>
            <div class="line"><b>fix</b><span>re-renders, measures again</span></div>
            <div class="line good"><b>done</b><span>3 problems fixed, 1800×1030 PNG</span></div>
          </div>
          <figure class="result" style="margin:0" data-with="6">
            <img src={img_chart.src} width="1200" height="687" alt="Line chart of monthly recurring revenue with annotated milestones, generated by a 7ar agent">
            <figcaption>revenue.png · delivered</figcaption>
          </figure>
        </div>
      </div>
    </div>
    <p class="note-mono" style="margin-top:16px">Condensed from the real chart run on the <a href="/showcase/">showcase</a> page (~36 tool calls).</p>
  </div>
</section>

<section style="padding:0">
  <div class="wrap">
    <div class="strip" data-reveal>
      <div><b>~30 MB</b><span>single Go binary</span></div>
      <div><b>~20 MB</b><span>idle memory</span></div>
      <div><b>5</b><span>document skills</span></div>
      <div><b>Any</b><span>OpenAI-style or Anthropic</span></div>
    </div>
  </div>
</section>

<section id="why">
  <div class="wrap">
    <p class="statement" data-reveal>Agents that check their own work. <span>Contained by default, shared by a whole team, and yours to embed.</span></p>
    <div class="figs">
      <div data-reveal>
        <p class="fig">Fig 0.1</p>
        <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true">
          <path d="M120 24 214 68 120 112 26 68Z"/><path d="M26 68v14l94 44 94-44V68"/><path d="M26 82v14l94 44 94-44V82" opacity=".7"/><path d="M26 96v14l94 44 94-44V96" opacity=".5"/><path d="M26 110v14l94 44 94-44v-14" opacity=".35"/>
          <ellipse cx="120" cy="68" rx="42" ry="18"/><path d="M82 64h76M80 70h80M86 75h68" opacity=".6"/>
        </svg>
        <h3>It looks at what it made</h3>
        <p>Pages render to images and checkers run on the file, so you review a finished deliverable.</p>
      </div>
      <div data-reveal style="--d:1">
        <p class="fig">Fig 0.2</p>
        <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true">
          <path d="M92 40l36 18v40l-36 18-36-18V58Z"/><path d="M56 58l36 18 36-18M92 76v40"/>
          <path d="M150 74l34 17v38l-34 17-34-17V91Z" opacity=".85"/><path d="M116 91l34 17 34-17M150 108v38" opacity=".85"/>
          <path d="M92 124l30 15v32l-30 15-30-15v-32Z" opacity=".6" transform="translate(0 -14)"/>
        </svg>
        <h3>Contained, then shared</h3>
        <p>One sandbox per thread with deny-by-default egress. Roles, shared sessions and an audit trail for the team.</p>
      </div>
      <div data-reveal style="--d:2">
        <p class="fig">Fig 0.3</p>
        <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true">
          <path d="M60 40l92-14v118l-92 14Z"/><path d="M72 46l10 96M86 44l10 98M100 42l10 100M114 40l10 100M128 38l10 100" opacity=".55"/>
          <path d="M40 150l112-14 40 18-112 14Z" opacity=".7"/><path d="M52 160l112-14M64 168l112-14" opacity=".4"/>
        </svg>
        <h3>Small enough to own</h3>
        <p>A ~30 MB Go binary and a narrow client contract. Embed it, self-host it, bring any model.</p>
      </div>
    </div>
  </div>
</section>

<section id="loop">
  <div class="wrap">
    <div class="story-head">
      <p class="eyebrow" data-reveal>The loop</p>
      <h2 data-reveal>Most agents stop when the file is written. <em>7ar keeps going.</em></h2>
      <p class="sub" data-reveal>The model drives a ReAct loop in Go; the sandbox only executes. Between "wrote the file" and "done", 7ar adds the step most agents skip: looking at the result.</p>
    </div>
    <div class="story">
      <div class="story-steps">
        <div class="story-step on">
          <p class="fig">Ask</p>
          <h3>Start anywhere your team already is</h3>
          <p>A message in the web UI, the terminal, Telegram or your own front end. Same agent, same session.</p>
        </div>
        <div class="story-step">
          <p class="fig">Build</p>
          <h3>Real files, from a real sandbox</h3>
          <p>Files, shell, search and skills (<code>pptx</code>, <code>xlsx</code>, <code>docx</code>, <code>pdf</code>, <code>charts</code>) run inside the container, not in your chat.</p>
        </div>
        <div class="story-step">
          <p class="fig">Look</p>
          <h3>It sees what the reader will see</h3>
          <p><code>view_file</code> renders PDF, DOCX, PPTX and XLSX pages to PNG so a vision model checks the actual page. Models that cannot see images get measurements instead.</p>
        </div>
        <div class="story-step">
          <p class="fig">Verify</p>
          <h3>Checkers send failures back</h3>
          <p>Text fit in slides, workbook validation, citations. A failed check goes back to the model, not to you.</p>
        </div>
        <div class="story-step">
          <p class="fig">Remember</p>
          <h3>Memory a human signs off on</h3>
          <p>Decisions and conventions become proposed memory. Nothing is used until a team member keeps it, and every edit keeps its history.</p>
        </div>
      </div>

      <div class="story-stage" aria-hidden="false">
        <div class="frame on">
          <p class="fig">Ask · surfaces</p>
          <div class="composer">Build a 5-slide board update for Nimbus: title, KPIs, a revenue chart, risks, next steps. Check the slides for overflow before you finish.<small>⏎ send to the thread</small></div>
          <div class="chips"><span class="chip on">Web UI</span><span class="chip">Terminal</span><span class="chip">Telegram</span><span class="chip">Your own app</span></div>
        </div>
        <div class="frame">
          <p class="fig">Build · skills in the sandbox</p>
          <div class="chips" style="margin-bottom:18px"><span class="chip on">pptx</span><span class="chip on">xlsx</span><span class="chip on">docx</span><span class="chip on">pdf</span><span class="chip on">charts</span></div>
          <div class="log" style="font-size:.78rem">
            <div class="line"><b>shell</b><span>one container per thread</span></div>
            <div class="line"><b>egress</b><span>deny by default</span></div>
            <div class="line"><b>token</b><span>GitHub token kept out by the egress vault</span></div>
          </div>
        </div>
        <div class="frame">
          <p class="fig">Look · view_file</p>
          <div class="shot"><img src={img_chart.src} width="1200" height="687" loading="lazy" alt="Revenue chart as rendered back to the agent for inspection"></div>
        </div>
        <div class="frame">
          <p class="fig">Verify · from the showcase runs</p>
          <ul class="checks">
            <li><span class="no">✕</span><span>chart: label past the right edge</span><em>fixed</em></li>
            <li><span class="ok">✓</span><span>deck: text fits on all 5 slides</span><em>fit check</em></li>
            <li><span class="ok">✓</span><span>workbook: 393 formulas, 0 error cells</span><em>recalc</em></li>
            <li><span class="ok">✓</span><span>charts and tables are native, editable objects</span><em>pptx</em></li>
          </ul>
        </div>
        <div class="frame">
          <p class="fig">Remember · project memory</p>
          <div class="shot"><img src={img_ui_memory.src} width="1200" height="1250" loading="lazy" alt="Project memory page with pinned entries, pending proposals to review, and entry history" style="height:330px;object-fit:cover;object-position:top"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="product">
  <div class="wrap">
    <div class="row-head">
      <h2 data-reveal>You stay in control</h2>
      <div data-reveal style="--d:1">
        <p>Risky tool calls pause for approve or deny; "always" grants autonomy for the run. Modes: ask, auto-edit, readonly, yolo.</p>
        <a href="/product/">The product</a>
      </div>
    </div>
    <div class="row-shot" data-reveal>
      <div class="shot"><img src={img_ui_approval.src} width="1190" height="440" loading="lazy" alt="A session paused on an approval: the agent wants to run go test with count 20 and waits for approve, approve always or deny"></div>
      <p class="caption">The real web UI against a demo server with canned data. No model is called.</p>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="row-head">
      <h2 data-reveal>Everything is inspectable</h2>
      <div data-reveal style="--d:1">
        <p>Collapsible tool calls, edit diffs, a live plan, and steering or cancel while a run is going. Shared sessions show who wrote each message.</p>
        <a href="/product/">See more screens</a>
      </div>
    </div>
    <div class="row-shot" data-reveal>
      <div class="shot"><img src={img_ui_session.src} width="1190" height="765" loading="lazy" alt="Session with a diff of the edited test file, a steer message from a teammate, and token and cache stats"></div>
    </div>
  </div>
</section>

<section id="value">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Added value</p>
    <h2 data-reveal>What a chat box or a coding CLI doesn't give you</h2>
    <div class="grid3">
      <div class="card" data-reveal>
        <h3>It checks its own work</h3>
        <p>Rendering plus per-format checkers mean the agent sees overflow, broken charts and formula errors before you do.</p>
        <span class="tag">view_file · features/verify</span>
      </div>
      <div class="card" data-reveal style="--d:1">
        <h3>Execution you can contain</h3>
        <p>One container per thread through OpenSandbox, with deny-by-default egress, dropped capabilities and a pids limit.</p>
        <span class="tag">or run local, no container</span>
      </div>
      <div class="card" data-reveal style="--d:2">
        <h3>One agent, a whole team</h3>
        <p>OIDC login, projects with owner, member and viewer roles, and an audit trail of who sent, steered or approved what.</p>
        <span class="tag">harness-web -team</span>
      </div>
      <div class="card" data-reveal>
        <h3>Memory your team controls</h3>
        <p>Project, personal and global layers. A model proposes; nothing is used until a member keeps it.</p>
        <span class="tag">pinned · recalled by meaning · reviewable</span>
      </div>
      <div class="card" data-reveal style="--d:1">
        <h3>An assistant that watches for you</h3>
        <p>A global agent flags sessions waiting for approval, failed or stuck. Approve a tool call from Telegram with a button.</p>
        <span class="tag">supervisor · Telegram bridge</span>
      </div>
      <div class="card" data-reveal style="--d:2">
        <h3>Yours to embed and own</h3>
        <p>A Go library with AG-UI event streaming that resumes after a dropped connection. Any OpenAI-compatible endpoint, or Anthropic.</p>
        <span class="tag">hosts/client · hosts/httpapi</span>
      </div>
    </div>
  </div>
</section>

<section id="try" class="closing">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Try it</p>
    <h2 data-reveal>See it work, then run your own</h2>
    <p class="sub" data-reveal>Open the hosted app, read how 7ar compares with other open-source agents, or clone the repository and run it on your machine.</p>
    <div class="cta" data-reveal>
      <a class="btn primary" href="https://app.7ar.chat">Open the app</a>
      <a class="btn" href="/showcase/">Showcase</a>
      <a class="btn" href="/compare/">Compare</a>
      <a class="btn" href="/get-started/">Get started</a>
      <a class="btn" href="https://github.com/7ar-chat/harness">GitHub</a>
    </div>
  </div>
</section>
</Layout>
